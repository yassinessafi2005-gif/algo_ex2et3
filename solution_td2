"""Solutions heuristiques des exercices 2 et 3 du TD2.

Exercice 2 : recherche tabou pour le problème de transport équilibré.
Exercice 3 : recherche tabou et recuit simulé pour le TSP (5 itérations).
Les méthodes sont volontairement limitées à celles demandées.
"""
from __future__ import annotations

import math
import random


# ---------------------------- Exercice 2 ---------------------------------
SUPPLIES = (8, 9)
DEMANDS = (4, 5, 8)
COSTS = ((5, 3, 4), (6, 7, 2))


def transport_cost(x: tuple[tuple[int, ...], ...]) -> int:
    return sum(x[i][j] * COSTS[i][j] for i in range(2) for j in range(3))


def feasible(x: tuple[tuple[int, ...], ...]) -> bool:
    return (all(sum(x[i]) == SUPPLIES[i] for i in range(2))
            and all(sum(x[i][j] for i in range(2)) == DEMANDS[j]
                    for j in range(3)) and all(v >= 0 for row in x for v in row))


def transport_neighbors(x: tuple[tuple[int, ...], ...]):
    """Voisinage par cycle 2x2, préservant toutes les sommes."""
    seen = set()
    for j1 in range(3):
        for j2 in range(j1 + 1, 3):
            # Ajouter d aux cases (D1,j1),(D2,j2) et retirer d aux autres.
            limit = min(x[0][j2], x[1][j1])
            for d in range(1, limit + 1):
                y = [list(x[0]), list(x[1])]
                y[0][j1] += d; y[1][j2] += d
                y[0][j2] -= d; y[1][j1] -= d
                key = tuple(tuple(row) for row in y)
                if key not in seen:
                    seen.add(key); yield key
            limit = min(x[0][j1], x[1][j2])
            for d in range(1, limit + 1):
                y = [list(x[0]), list(x[1])]
                y[0][j1] -= d; y[1][j2] -= d
                y[0][j2] += d; y[1][j1] += d
                key = tuple(tuple(row) for row in y)
                if key not in seen:
                    seen.add(key); yield key


def tabu_transport(max_iterations: int = 20, tenure: int = 3):
    # Solution initiale réalisable par le coin nord-ouest.
    current = ((4, 4, 0), (0, 1, 8))
    best, best_cost = current, transport_cost(current)
    tabu: dict[tuple, int] = {}
    history = []
    for iteration in range(max_iterations):
        candidates = []
        for candidate in transport_neighbors(current):
            cost = transport_cost(candidate)
            if tabu.get(candidate, -1) > iteration and cost >= best_cost:
                continue
            candidates.append((cost, candidate))
        if not candidates:
            break
        cost, current = min(candidates, key=lambda item: (item[0], item[1]))
        tabu[current] = iteration + tenure
        if cost < best_cost:
            best, best_cost = current, cost
        history.append((iteration + 1, current, cost, best_cost))
    return best, best_cost, history


# ---------------------------- Exercice 3 ---------------------------------
# Graphe non orienté; les tirets du tableau représentent des liaisons absentes.
N = 8
EDGES = {
    (1, 2): 14, (1, 3): 15, (1, 8): 17,
    (2, 3): 13, (2, 4): 14, (2, 5): 20, (2, 8): 21,
    (3, 4): 11, (3, 5): 21, (3, 6): 17, (3, 7): 9, (3, 8): 9,
    (4, 5): 11, (4, 6): 10, (4, 7): 8, (4, 8): 20,
    (5, 6): 15, (5, 7): 18,
    (6, 7): 9, (7, 8): 13,
}
DIST = {**EDGES, **{(b, a): c for (a, b), c in EDGES.items()}}
INITIAL = (1, 2, 3, 4, 5, 6, 7, 8)


def tour_cost(tour: tuple[int, ...]) -> float:
    cycle = tour + (tour[0],)
    try:
        return sum(DIST[(cycle[i], cycle[i + 1])] for i in range(N))
    except KeyError:
        return math.inf


def two_opt_neighbors(tour: tuple[int, ...]):
    # Ville 1 reste fixée; chaque mouvement inverse un segment du cycle.
    for i in range(1, N - 1):
        for j in range(i + 1, N):
            candidate = tour[:i] + tuple(reversed(tour[i:j + 1])) + tour[j + 1:]
            if math.isfinite(tour_cost(candidate)):
                yield candidate


def tabu_tsp(max_iterations: int = 20, tenure: int = 5):
    current = INITIAL
    best, best_cost = current, tour_cost(current)
    tabu: dict[tuple, int] = {}
    log = []
    for iteration in range(max_iterations):
        choices = []
        for candidate in two_opt_neighbors(current):
            cost = tour_cost(candidate)
            if tabu.get(candidate, -1) > iteration and cost >= best_cost:
                continue
            choices.append((cost, candidate))
        if not choices:
            break
        cost, current = min(choices, key=lambda item: (item[0], item[1]))
        tabu[current] = iteration + tenure
        if cost < best_cost:
            best, best_cost = current, cost
        log.append((iteration + 1, current, cost, best_cost))
    return best, best_cost, log


def simulated_annealing_tsp(iterations: int = 5, seed: int = 7):
    rng = random.Random(seed)
    current = INITIAL
    current_cost = tour_cost(current)
    best, best_cost = current, current_cost
    # T0 empirique: 5% du coût initial; refroidissement linéaire jusqu'à 1.
    temperature = max(1.0, 0.05 * current_cost)
    log = []
    for step in range(1, iterations + 1):
        candidates = list(two_opt_neighbors(current))
        candidate = rng.choice(candidates)
        candidate_cost = tour_cost(candidate)
        delta = candidate_cost - current_cost
        accepted = delta <= 0 or rng.random() < math.exp(-delta / temperature)
        if accepted:
            current, current_cost = candidate, candidate_cost
        if current_cost < best_cost:
            best, best_cost = current, current_cost
        log.append((step, temperature, candidate, candidate_cost, accepted,
                    current, current_cost, best, best_cost))
        temperature = max(1.0, temperature - 1.0)
    return best, best_cost, log


def show_tour(tour: tuple[int, ...]) -> str:
    return "-".join(map(str, tour + (tour[0],)))


def main():
    x, value, log = tabu_transport()
    print("EXERCICE 2 - recherche tabou")
    print("Matrice D1,D2 x M1,M2,M3:", x)
    print("Coût total:", value)
    print("Itérations:", len(log))
    print("\nEXERCICE 3 - recherche tabou")
    tour, value, log = tabu_tsp()
    print("Tour initial:", show_tour(INITIAL), "coût =", tour_cost(INITIAL))
    for it, state, cost, incumbent in log:
        print(f"{it:2d}: {show_tour(state)} | coût={cost} | meilleur={incumbent}")
    print("Meilleur tour tabou:", show_tour(tour), "coût =", value)
    print("\nEXERCICE 3 - recuit simulé (5 itérations, seed=7)")
    tour, value, log = simulated_annealing_tsp()
    for it, temp, proposal, proposal_cost, accepted, state, cost, incumbent, incumbent_cost in log:
        print(f"{it}: T={temp:.1f}, proposition={show_tour(proposal)} ({proposal_cost}), "
              f"{'acceptée' if accepted else 'rejetée'}, état={show_tour(state)} ({cost}), "
              f"meilleur={show_tour(incumbent)} ({incumbent_cost})")
    print("Meilleur tour recuit:", show_tour(tour), "coût =", value)


if __name__ == "__main__":
    main()
